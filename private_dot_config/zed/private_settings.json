{
  "agent_buffer_font_size": 12.0,
  "agent_ui_font_size": 14.0,
  "tabs": {
    "file_icons": true
  },
  "agent": {
    "tool_permissions": {
      "tools": {
        "fetch": {
          "default": "allow"
        },
        "terminal": {
          "default": "allow"
        }
      }
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "show_whitespaces": "trailing",
  "soft_wrap": "editor_width",
  "terminal": {
    "font_size": 12.0,
    "dock": "right"
  },
  "project_panel": {
    "dock": "right"
  },
  "search": {
    "include_ignored": true
  },
  "icon_theme": "Catppuccin Mocha",
  "buffer_font_weight": 400.0,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "preview_tabs": {
    "enabled": false
  },
  "minimap": {
    "show": "always"
  },
  "use_system_window_tabs": true,
  "buffer_font_fallbacks": [
    "Migu 1M"
  ],
  "buffer_font_family": "HackGen Console NF",
  "wrap_guides": [
    140
  ],
  "base_keymap": "VSCode",
  "ui_font_size": 12.0,
  "buffer_font_size": 12.0,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark"
  },
  "lsp": {
    "gopls": {
      "initialization_options": {
        "gofumpt": true,
        "staticcheck": true,
        "hints": {
            "assignVariableTypes": true,
            "compositeLiteralFields": true,
            "compositeLiteralTypes": true,
            "constantValues": true,
            "functionTypeParameters": true,
            "parameterNames": true,
            "rangeVariableTypes": true
        }
      }
    }
  }
}
