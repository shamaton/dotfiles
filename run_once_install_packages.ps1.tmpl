{{- if eq .chezmoi.os "windows" -}}
# Install Scoop
if (-not (Get-Command scoop -ErrorAction SilentlyContinue)) {
  Write-Host "Installing Scoop..."
  Set-ExecutionPolicy -ExecutionPolicy RemoteSigned -Scope CurrentUser -Force
  Invoke-RestMethod -Uri https://get.scoop.sh | Invoke-Expression
}

# Add extras bucket (required for btop, zellij, etc.)
scoop bucket add extras 2>$null

# Install packages
Write-Host "Installing packages via Scoop..."
scoop install neovim bat eza chezmoi zsh direnv mise gnupg

# btop: scoop manifest has a known bug creating btop.conf (already exists after extraction)
# Install and suppress the non-fatal exit code
Write-Host "Installing btop..."
scoop install btop
if ($LASTEXITCODE -ne 0) {
  Write-Warning "btop installation completed with warnings (known scoop manifest issue)."
}

Write-Host "Installing zellij..."
scoop install zellij
if ($LASTEXITCODE -ne 0) {
  Write-Warning "zellij installation completed with warnings."
}

# Install mise-managed tools
Write-Host "Installing mise-managed tools..."
mise install

# Install oh-my-zsh
if (-not (Test-Path "$env:USERPROFILE\.oh-my-zsh")) {
  Write-Host "Installing oh-my-zsh..."
  $env:RUNZSH = "no"
  $env:CHSH = "no"
  $env:KEEP_ZSHRC = "yes"
  sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
}

# Install zsh theme and plugins
$ZSH_CUSTOM = if ($env:ZSH_CUSTOM) { $env:ZSH_CUSTOM } else { "$env:USERPROFILE\.oh-my-zsh\custom" }

if (-not (Test-Path "$ZSH_CUSTOM\themes\powerlevel10k")) {
  Write-Host "Installing Powerlevel10k theme..."
  git clone --depth=1 https://github.com/romkatv/powerlevel10k.git "$ZSH_CUSTOM\themes\powerlevel10k"
}

if (-not (Test-Path "$ZSH_CUSTOM\plugins\zsh-autosuggestions")) {
  Write-Host "Installing zsh-autosuggestions..."
  git clone https://github.com/zsh-users/zsh-autosuggestions "$ZSH_CUSTOM\plugins\zsh-autosuggestions"
}

if (-not (Test-Path "$ZSH_CUSTOM\plugins\zsh-syntax-highlighting")) {
  Write-Host "Installing zsh-syntax-highlighting..."
  git clone https://github.com/zsh-users/zsh-syntax-highlighting "$ZSH_CUSTOM\plugins\zsh-syntax-highlighting"
}

if (-not (Test-Path "$ZSH_CUSTOM\plugins\zsh-history-substring-search")) {
  Write-Host "Installing zsh-history-substring-search..."
  git clone https://github.com/zsh-users/zsh-history-substring-search "$ZSH_CUSTOM\plugins\zsh-history-substring-search"
}

if (-not (Test-Path "$ZSH_CUSTOM\plugins\zsh-abbr")) {
  Write-Host "Installing zsh-abbr..."
  git clone --recurse-submodules --single-branch --branch v6 --depth 1 https://github.com/olets/zsh-abbr "$ZSH_CUSTOM\plugins\zsh-abbr"
}

Write-Host "Setup complete."
exit 0
{{- end }}
