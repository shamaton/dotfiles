# --- Homebrew ---
{{- if eq .chezmoi.os "darwin" }}
eval "$(/opt/homebrew/bin/brew shellenv)"
{{- else if eq .chezmoi.os "linux" }}
eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
{{- end }}

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# --- Oh My Zsh ---
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"

# - と _ を補完で同一視する
HYPHEN_INSENSITIVE="true"

# Oh My Zsh を自動更新する
zstyle ':omz:update' mode auto

# 補完待機中にドットを表示する
COMPLETION_WAITING_DOTS="true"

# history コマンドの出力に日付を表示する
HIST_STAMPS="yyyy-mm-dd"

# プラグイン (多すぎると起動が遅くなるため注意)
plugins=(git docker zsh-autosuggestions zsh-syntax-highlighting zsh-history-substring-search zsh-abbr mise)

source $ZSH/oh-my-zsh.sh

# --- 環境変数 ---

# 文字コード
export LANG=en_US.UTF-8

# デフォルトエディタ (SSH 接続時は vim、ローカルは nvim)
if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='vim'
else
  export EDITOR='nvim'
fi

# ローカルバイナリを PATH に追加
export PATH="$HOME/bin:$HOME/.local/bin:$PATH"

# --- 履歴 (zsh ネイティブ設定) ---
HISTSIZE=10000
SAVEHIST=10000
setopt HIST_IGNORE_SPACE    # スペース始まりのコマンドを記録しない
setopt HIST_IGNORE_ALL_DUPS # 重複コマンドを記録しない
setopt HIST_REDUCE_BLANKS   # 余分なスペースを除去して記録
setopt SHARE_HISTORY        # 複数ターミナル間で履歴を共有
setopt EXTENDED_HISTORY     # タイムスタンプ付きで記録

# --- 動作設定 ---
setopt AUTO_CD  # ディレクトリ名だけで cd できる

# --- 追加設定の読み込み ---
if [[ -f "$HOME/.config/my-zsh/entry.zsh" ]]; then
  source "$HOME/.config/my-zsh/entry.zsh"
fi

# --- キーバインド (history-substring-search) ---
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down
bindkey "$terminfo[kcuu1]" history-substring-search-up
bindkey "$terminfo[kcud1]" history-substring-search-down

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# if vcs is heavily, set disable vcs segment in p10k.
# For example, when you work on a large git repository over SSH, it can cause significant performance issues.
# In such cases, you can disable the vcs segment in Powerlevel10k to improve performance.
function _p10k_update_vcs_mode() {
  export P10K_DISABLE_VCS=0

  [[ -n "$SSH_CONNECTION" ]] || return 0

  local repo_root
  repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || return 0

  case "$repo_root" in
    "C:/works/Siglo/sdk")
      export P10K_DISABLE_VCS=1
      ;;
  esac

  source ~/.p10k.zsh
}

autoload -Uz add-zsh-hook
add-zsh-hook chpwd _p10k_update_vcs_mode
_p10k_update_vcs_mode
