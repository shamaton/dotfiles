{{- if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
#!/bin/bash
set -euo pipefail

OS="{{ .chezmoi.os }}"

BREW_PACKAGES=(eza btop)
if [[ "$OS" == "linux" ]]; then
  BREW_PACKAGES+=(gnupg)
fi

ZSH_CUSTOM="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"

main() {
  install_homebrew
  install_brew_packages
  install_mise
  if [[ "$OS" == "linux" ]]; then
    import_node_gpg_keys
  fi
  install_mise_tools
  remove_installer_chezmoi
  install_oh_my_zsh
  install_zsh_plugins
  echo "Setup complete."

  if [[ "$OS" == "linux" ]]; then
    set_default_shell_to_zsh
    exec "$(command -v zsh)" -l
  fi
}

install_homebrew() {
  if command -v brew &>/dev/null; then
    return
  fi
  echo "Installing Homebrew..."
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

  local brew_bin
  for brew_bin in /opt/homebrew/bin/brew /home/linuxbrew/.linuxbrew/bin/brew "$HOME/.linuxbrew/bin/brew"; do
    if [[ -f "$brew_bin" ]]; then
      eval "$("$brew_bin" shellenv)"
      return
    fi
  done
}

install_brew_packages() {
  echo "Installing packages via Homebrew..."
  brew install "${BREW_PACKAGES[@]}"
}

install_mise() {
  if [[ ! -x "$HOME/.local/bin/mise" ]]; then
    echo "Installing mise..."
    curl -fsSL https://mise.run | sh
  fi
  export PATH="$HOME/.local/bin:$PATH"
}

# Import Node.js release team GPG keys for mise signature verification
import_node_gpg_keys() {
  echo "Importing Node.js GPG keys..."
  # Kill any stale gpg-agent/keyboxd/dirmngr from a previously-installed (older)
  # gnupg so the newly-installed brew gnupg starts its own agents and keyrings.
  gpgconf --kill all 2>/dev/null || true
  local base="https://raw.githubusercontent.com/nodejs/release-keys/main"
  local key
  curl -fsSL "${base}/keys.list" | while read -r key; do
    [[ -z "$key" ]] && continue
    curl -fsSL "${base}/keys/${key}.asc" | gpg --import
  done
}

install_mise_tools() {
  echo "Installing mise-managed tools..."
  mise install
}

# Remove chezmoi binary downloaded by the one-line installer
remove_installer_chezmoi() {
  if [[ -f "$HOME/chezmoi" ]]; then
    echo "Removing $HOME/chezmoi..."
    rm -f "$HOME/chezmoi"
  fi
}

install_oh_my_zsh() {
  if [[ ! -d "$HOME/.oh-my-zsh" ]]; then
    echo "Installing oh-my-zsh..."
    RUNZSH=no CHSH=no KEEP_ZSHRC=yes sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
  fi
}

# Usage: clone_if_missing <dest> <git clone args...>
clone_if_missing() {
  local dest="$1"
  shift
  if [[ ! -d "$dest" ]]; then
    echo "Installing $(basename "$dest")..."
    git clone "$@" "$dest"
  fi
}

install_zsh_plugins() {
  clone_if_missing "$ZSH_CUSTOM/themes/powerlevel10k" \
    --depth=1 https://github.com/romkatv/powerlevel10k.git
  clone_if_missing "$ZSH_CUSTOM/plugins/zsh-autosuggestions" \
    https://github.com/zsh-users/zsh-autosuggestions
  clone_if_missing "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting" \
    https://github.com/zsh-users/zsh-syntax-highlighting
  clone_if_missing "$ZSH_CUSTOM/plugins/zsh-history-substring-search" \
    https://github.com/zsh-users/zsh-history-substring-search
  clone_if_missing "$ZSH_CUSTOM/plugins/zsh-abbr" \
    --recurse-submodules --single-branch --branch v6 --depth 1 https://github.com/olets/zsh-abbr
}

set_default_shell_to_zsh() {
  local zsh_path
  zsh_path="$(command -v zsh)"
  if [[ "$SHELL" == "$zsh_path" ]]; then
    return
  fi
  echo "Setting default shell to zsh..."
  if ! grep -qF "$zsh_path" /etc/shells; then
    if [[ "$EUID" -eq 0 ]]; then
      echo "$zsh_path" >> /etc/shells
    else
      echo "$zsh_path" | sudo tee -a /etc/shells
    fi
  fi
  if [[ "$EUID" -eq 0 ]]; then
    chsh -s "$zsh_path"
  else
    sudo chsh -s "$zsh_path" "$USER"
  fi
}

main "$@"
{{ end -}}
